        "custom_liquid": "{%- comment -%}トップ：ジャーナル（最新3本）への誘導{%- endcomment -%}\n{%- assign jb = blogs.journal -%}\n{%- if jb.articles_count > 0 -%}\n{%- assign en = false -%}{%- if request.locale.iso_code == 'en' -%}{%- assign en = true -%}{%- endif -%}\n<section class=\"yt-jtop page-width\">\n<div class=\"yt-style__hd\"><h2>{% if en %}Journal{% else %}山の道具の読みもの{% endif %}</h2><span>JOURNAL</span></div>\n<p class=\"yt-jtop__lead\">{% if en %}How we choose gear for Japan's steep mountains.{% else %}標高差の大きい日本の山で、道具をどう選ぶか。作り手の目線で書いています。{% endif %}</p>\n<ul class=\"yt-jtop__grid\">\n{%- for a in jb.articles limit: 3 -%}\n<li><a href=\"{{ a.url }}\" class=\"yt-jtop__card\">\n<span class=\"yt-jtop__img\">{%- if a.image -%}<img src=\"{{ a.image | image_url: width: 600 }}\" srcset=\"{{ a.image | image_url: width: 400 }} 400w, {{ a.image | image_url: width: 800 }} 800w\" sizes=\"(max-width: 749px) 78vw, 33vw\" alt=\"{{ a.title | split: '｜' | first | escape }}\" loading=\"lazy\" decoding=\"async\" width=\"600\" height=\"{{ 600 | divided_by: a.image.aspect_ratio | round }}\">{%- endif -%}<i>No.{{ jb.articles_count | minus: forloop.index0 }}</i></span>\n<span class=\"yt-jtop__t\">{{ a.title | split: '｜' | first }}</span>\n<span class=\"yt-jtop__d\">{{ a.published_at | date: '%Y.%m.%d' }}</span>\n</a></li>\n{%- endfor -%}\n</ul>\n<div class=\"yt-jtop__more\"><a href=\"{{ jb.url }}\">{% if en %}All articles{% else %}すべての記事を見る{% endif %} <span aria-hidden=\"true\">→</span></a></div>\n</section>\n<style>\n#shopify-section-{{ section.id }}{background:#fff;border-top:1px solid #e4dfd5;margin-top:24px}#shopify-section-{{ section.id }}>div,#shopify-section-{{ section.id }} .color-scheme-1,#shopify-section-{{ section.id }} .gradient{background:#fff!important}.yt-jtop{padding-top:48px;padding-bottom:48px}\n.yt-jtop .yt-style__hd{display:flex;align-items:baseline;gap:12px;margin:0 0 6px}\n.yt-jtop .yt-style__hd h2{margin:0}\n.yt-jtop .yt-style__hd span{font-size:11px;letter-spacing:.2em;color:#8a7f6e;font-weight:600}\n.yt-jtop__lead{margin:0 0 18px;font-size:14px;color:#555;line-height:1.8}\n.yt-jtop__grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}\n.yt-jtop__card{display:flex;flex-direction:column;gap:8px;color:inherit;text-decoration:none}\n.yt-jtop__img{position:relative;display:block;aspect-ratio:3/2;overflow:hidden;border-radius:6px;background:#f2efe9}\n.yt-jtop__img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}\n.yt-jtop__card:hover img{transform:scale(1.03)}\n.yt-jtop__img i{position:absolute;top:10px;left:10px;font-style:normal;padding:3px 9px;background:rgba(var(--color-foreground),.9);color:rgb(var(--color-background));font-size:12px;letter-spacing:.1em;border-radius:2px}\n.yt-jtop__t{font-size:16px;font-weight:700;line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}\n.yt-jtop__card:hover .yt-jtop__t{text-decoration:underline;text-underline-offset:.25em}\n.yt-jtop__d{font-size:12px;color:#8a7f6e;letter-spacing:.05em}\n.yt-jtop__more{margin-top:22px;text-align:center}\n.yt-jtop__more a{display:inline-block;padding:12px 28px;border:1px solid #1a1a1a;border-radius:999px;color:#1a1a1a;text-decoration:none;font-weight:700;font-size:14px}\n.yt-jtop__more a:hover{background:#1a1a1a;color:#fff}\n@media (max-width:749px){.yt-jtop__grid{grid-auto-flow:column;grid-template-columns:none;grid-auto-columns:78%;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 1.5rem;gap:14px;margin:0 -1.5rem;padding:0 1.5rem 4px}.yt-jtop__grid li{scroll-snap-align:start}.yt-jtop__t{font-size:15px}}\n</style>\n{%- endif -%}\n",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
