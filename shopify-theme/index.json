span class=\"yt-cat__name\"><span>{% if en %}<b>{{ x[2] }}</b>{% else %}<b>{{ x[1] }}</b><small>{{ x[2] | upcase }}</small>{% endif %}</span><i>→</i></span></a></li>\n{%- endfor -%}\n</ul>\n</section>\n<section class=\"yt-style\">\n<div class=\"yt-style__hd\"><h2>{% if en %}Styles for mountain &amp; city{% else %}山と街のスタイル{% endif %}</h2><span>STYLE</span></div>\n<div class=\"yt-style__grid\">\n{%- assign rows = looks | split: '~' -%}\n{%- for row in rows -%}\n{%- assign c = row | strip | split: '|' -%}\n{%- assign handles = c[7] | strip | split: ',' -%}\n{%- assign total = 0 -%}\n<article class=\"yt-lk\">\n<div class=\"yt-lk__ph\">\n<img src=\"{{ F }}{{ c[2] }}&width=600\" srcset=\"{{ F }}{{ c[2] }}&width=400 400w, {{ F }}{{ c[2] }}&width=600 600w, {{ F }}{{ c[2] }}&width=900 900w\" sizes=\"(max-width: 749px) 92vw, 46vw\" alt=\"\" loading=\"lazy\" decoding=\"async\" width=\"900\" height=\"900\">\n<div class=\"yt-lk__cap\"><p class=\"yt-lk__no\">{{ c[1] }}</p><h3>{% if en %}{{ c[4] }}{% else %}{{ c[3] }}{% endif %}</h3></div>\n</div>\n<div class=\"yt-lk__txt\">\n<ul class=\"yt-lk__items\">\n{%- for h in handles -%}\n{%- assign p = all_products[h] -%}\n{%- if p.title != blank -%}\n{%- assign total = total | plus: p.price -%}\n<li><a href=\"{{ p.url }}\"><img src=\"{{ p.featured_image | image_url: width: 120 }}\" alt=\"\" loading=\"lazy\" decoding=\"async\" width=\"56\" height=\"56\"><span><b>{{ p.title | split: '（' | first }}</b><em>{{ p.price | money }}{% unless p.available %}<i>{% if en %}Sold out{% else %}在庫切れ{% endif %}</i>{% endunless %}</em></span></a></li>\n{%- endif -%}\n{%- endfor -%}\n</ul>\n<div class=\"yt-lk__foot\"><span>{% if en %}Total{% else %}合計{% endif %} <b>{{ total | money }}</b>{% unless en %}（税込）{% endunless %}</span></div>\n</div>\n</article>\n{%- endfor -%}\n</div>\n</section>\n<style>\n.yt-style{max-width:1200px;margin:0 auto;padding:36px 20px 48px}\n.yt-style__hd{display:flex;align-items:baseline;gap:14px;margin:0 0 20px}.yt-style__hd h2{font-size:clamp(22px,2.6vw,28px);margin:0;font-weight:700}.yt-style__hd span{font-size:12px;letter-spacing:.3em;color:#8a7f6e;font-weight:700}\n.yt-style__grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}\n.yt-lk{background:#fff;border-radius:8px;overflow:hidden;display:flex;flex-direction:column;content-visibility:auto;contain-intrinsic-size:auto 900px}\n.yt-lk__ph{position:relative;aspect-ratio:1/1;background:#e6e2da}.yt-lk__ph img{width:100%;height:100%;object-fit:cover;display:block}\n.yt-lk__ph::after{content:\"\";position:absolute;left:0;right:0;bottom:0;height:45%;background:linear-gradient(180deg,rgba(0,0,0,0),rgba(0,0,0,.6))}\n.yt-lk__cap{position:absolute;z-index:1;left:0;right:0;bottom:0;padding:18px 20px;color:#fff;text-shadow:0 1px 8px rgba(0,0,0,.35)}\n.yt-lk__no{font-size:11px;letter-spacing:.25em;font-weight:700;margin:0 0 4px;opacity:.85}\n.yt-lk h3{font-size:20px;margin:0;line-height:1.45;color:#fff}\n.yt-lk__txt{padding:14px 16px 18px;display:flex;flex-direction:column;flex:1}\n.yt-lk__items{list-style:none;margin:0 0 12px;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:8px}\n.yt-lk__items a{display:flex;gap:10px;align-items:center;border:1px solid #eee9df;border-radius:6px;padding:6px;text-decoration:none;color:#111;height:100%;box-sizing:border-box}\n.yt-lk__items a:hover{border-color:#111}\n.yt-lk__items img{width:48px;height:48px;flex:none;object-fit:cover;border-radius:4px;background:#f2efe9}\n.yt-lk__items b{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:12px;line-height:1.45;font-weight:600}.yt-lk__items em{font-style:normal;font-size:12px;color:#666}\n.yt-lk__items i{font-style:normal;margin-left:6px;color:#b33;font-weight:700}\n.yt-lk__foot{margin-top:auto;font-size:13px}.yt-lk__foot b{font-size:17px}\n.yt-cat{max-width:1200px;margin:0 auto;padding:40px 5rem 4px}\n.yt-cat__grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(6,1fr);gap:16px}\n.yt-cat__grid a{display:block;text-decoration:none;color:#111}\n.yt-cat__img{display:block;aspect-ratio:1/1;border-radius:8px;overflow:hidden;background:#f2efe9}\n.yt-cat__img img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.2);transition:transform .5s}\n.yt-cat__grid a:hover .yt-cat__img img{transform:scale(1.27)}\n.yt-cat__name{display:flex;justify-content:space-between;align-items:center;gap:6px;margin-top:10px;padding:0 2px}\n.yt-cat__name b{display:block;font-size:15px;font-weight:700;line-height:1.4}.yt-cat__name small{display:block;font-size:10px;letter-spacing:.18em;color:#8a7f6e;font-weight:700;margin-top:2px}\n.yt-cat__name i{font-style:normal;font-size:15px;color:#8a7f6e;transition:transform .3s}.yt-cat__grid a:hover .yt-cat__name i{transform:translateX(3px);color:#111}\n@media (max-width:749px){.yt-cat{padding:28px 16px 0}.yt-cat__grid{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:30%;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;margin:0 -16px;padding:0 16px 4px;scroll-padding:0 16px;scrollbar-width:none}.yt-cat__grid::-webkit-scrollbar{display:none}.yt-cat__grid li{scroll-snap-align:start}.yt-cat__name{margin-top:8px}.yt-cat__name b{font-size:13px}.yt-cat__name small{font-size:9px;letter-spacing:.1em}.yt-cat__name i{display:none}}\n@media (max-width:749px){.yt-style__grid{grid-template-columns:1fr;gap:20px}.yt-style{padding:28px 16px 36px}}\n</style>\n{%- liquid\nassign mo = 'now' | date: '%m' | plus: 0\nif mo >= 4 and mo <= 9\nassign s_in = 'season-summer'\nassign s_off = '6616045'\nelse\nassign s_in = '6616045'\nassign s_off = 'season-summer'\nendif\n-%}\n<script>window.ytSeason={off:{{ collections[s_off].products | map: 'handle' | json }},inn:{{ collections[s_in].products | map: 'handle' | json }},food:{{ collections['7216875'].products | map: 'handle' | json }}};</script>\n<section class=\"yt-store\" id=\"yt-store\"><div class=\"yt-store__in\"><div class=\"yt-store__ph\"><img src=\"https://cdn.shopify.com/s/files/1/0745/1102/4295/files/store-sign-kiyosumi.jpg?v=1792936856&width=700\" srcset=\"https://cdn.shopify.com/s/files/1/0745/1102/4295/files/store-sign-kiyosumi.jpg?v=1792936856&width=500 500w, https://cdn.shopify.com/s/files/1/0745/1102/4295/files/store-sign-kiyosumi.jpg?v=1792936856&width=700 700w, https://cdn.shopify.com/s/files/1/0745/1102/4295/files/store-sign-kiyosumi.jpg?v=1792936856&width=1000 1000w\" sizes=\"(max-width: 749px) 100vw, 540px\" alt=\"\" loading=\"lazy\" decoding=\"async\" width=\"1000\" height=\"1000\"></div><div class=\"yt-store__tx\"><p class=\"yt-store__eb\">OUR STORE</p><h2>{% if en %}YAMATABI<span>Kiyosumi-Shirakawa, Tokyo</span>{% else %}山と旅の道具「山旅」<span>清澄白河店</span>{% endif %}</h2><p class=\"yt-store__lead\">{% if en %}See and try every YAMATABI product in person.{% else %}山旅の全アイテムを、実際に手に取って選べます。{% endif %}</p><dl><div><dt>{% if en %}Hours{% else %}営業{% endif %}</dt><dd>{% if en %}Fri, Sat & Sun 13:00–18:00{% else %}金・土・日 13:00〜18:00{% endif %}</dd></div><div><dt>{% if en %}Access{% else %}アクセス{% endif %}</dt><dd>{% if en %}2 min from Kiyosumi-Shirakawa Sta.{% else %}清澄白河駅 徒歩2分{% endif %}</dd></div><div><dt>{% if en %}Address{% else %}住所{% endif %}</dt><dd>{% if en %}1-3-13 Shirakawa, Koto-ku, Tokyo{% else %}東京都江東区白河1-3-13 清州寮{% endif %}</dd></div></dl><a class=\"yt-store__btn\" href=\"/pages/direct-store\">{% if en %}Store info & access{% else %}店舗情報・アクセス{% endif %} →</a></div></div></section>\n<style>[id$=\"__image_banner\"]{display:none!important}.yt-store{background:#fff}.yt-store__in{max-width:1200px;margin:0 auto;padding:64px 5rem;display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}.yt-store__ph{aspect-ratio:1/1;border-radius:8px;overflow:hidden;background:#e6e2da}.yt-store__ph img{width:100%;height:100%;object-fit:cover;display:block}.yt-store__eb{font-size:12px;letter-spacing:.3em;color:#8a7f6e;font-weight:700;margin:0 0 14px}.yt-store h2{font-size:clamp(22px,2.4vw,30px);line-height:1.5;margin:0 0 14px;font-weight:700;letter-spacing:.04em}.yt-store h2 span{display:block;font-size:.7em;color:#555;letter-spacing:.08em}.yt-store__lead{font-size:15px;line-height:1.9;color:#444;margin:0 0 24px}.yt-store dl{margin:0 0 28px;border-top:1px solid #e6e2da}.yt-store dl div{display:grid;grid-template-columns:5.5em 1fr;gap:12px;padding:14px 0;border-bottom:1px solid #e6e2da;font-size:14px;line-height:1.6}.yt-store dt{color:#8a7f6e;font-weight:700}.yt-store dd{margin:0;color:#111}.yt-store__btn{display:inline-flex;align-items:center;justify-content:center;height:50px;padding:0 32px;border:1px solid #111;border-radius:999px;color:#111;text-decoration:none;font-size:14px;font-weight:700;white-space:nowrap;transition:background .2s,color .2s}.yt-store__btn:hover{background:#111;color:#fff}@media (max-width:749px){.yt-store__in{grid-template-columns:1fr;gap:28px;padding:40px 16px 48px}.yt-store__ph{aspect-ratio:4/3}.yt-store h2{font-size:22px}.yt-store__lead{font-size:14px;margin-bottom:20px}.yt-store dl div{grid-template-columns:5em 1fr;font-size:13.5px}.yt-store__btn{display:flex;width:100%}}\n[id$=\"__row_new_arrivals\"] .collection__title,[id$=\"__best_sellers\"] .collection__title{display:flex;align-items:baseline;justify-content:space-between;gap:12px;width:100%}[id$=\"__row_new_arrivals\"] .collection__view-all{display:none}.yt-more{flex:none;margin-left:auto!important;font-size:14px;font-weight:700;color:#111;text-decoration:none;border-bottom:1px solid #111;padding-bottom:2px}.yt-more:hover{opacity:.7}</style>\n<script>document.addEventListener('DOMContentLoaded',function(){var S=window.ytSeason||{off:[],inn:[]};var L={'__best_sellers':'/collections/best-sellers','__row_new_arrivals':'/collections/new-arrivals'};Object.keys(L).forEach(function(k){var s=document.querySelector('[id$=\"'+k+'\"]');if(!s)return;var t=s.querySelector('.collection__title');if(t&&!t.querySelector('.yt-more')){var l=document.createElement('a');l.href=L[k];l.className='yt-more';l.textContent='{% if en %}View all{% else %}すべて見る{% endif %} →';t.appendChild(l);}var ul=s.querySelector('ul.product-grid');if(!ul)return;var items=[].slice.call(ul.children).map(function(li){var a=li.querySelector('a[href*=\"/products/\"]');var h=a?a.getAttribute('href').split('/products/')[1].split(/[?#]/)[0]:'';return {li:li,h:h,so:!!li.querySelector('.price--sold-out')};});items.forEach(function(x){if(S.off.indexOf(x.h)>-1)x.li.remove();});items=items.filter(function(x){return S.off.indexOf(x.h)<0;});var F=S.food||[],fc=0,keep=[];items.forEach(function(x){var ok=!x.so&&keep.length<8;if(ok&&k==='__best_sellers'&&F.indexOf(x.h)>-1){if(fc>=2)ok=false;else fc++;}if(ok)keep.push(x);});if(keep.length<8){items.forEach(function(x){if(keep.length<8&&keep.indexOf(x)<0&&(k!=='__best_sellers'||F.indexOf(x.h)<0||fc<2)){keep.push(x);}});}items.forEach(function(x){if(keep.indexOf(x)<0)x.li.remove();});items=keep;var rank=function(x){return x.so?2:(S.inn.indexOf(x.h)>-1?0:1);};items.map(function(x,i){return [rank(x),i,x];}).sort(function(a,b){return a[0]-b[0]||a[1]-b[1];}).forEach(function(r){ul.appendChild(r[2].li);});});var b=document.querySelector('[id$=\"__image_banner\"]'),st=document.getElementById('yt-store');if(b&&st)b.parentNode.insertBefore(st,b);});</script>",
